# Copy this file to .env (which is git-ignored) and set the absolute paths to your
# local Knaves' Needs multiloader mod roots. One key per supported MC version, named
# MOD_PATH_<version with dots replaced by underscores>.
#
# This file is read by the GUI (`python -m gui`), which shows the saved path for the
# selected version in its output box and passes it to the generator on the command line.
# `main.py` itself never reads .env: a bare `python main.py` stages into the local
# ./<loader> folders, and only ever writes into a mod project when handed the path
# explicitly, so a run cannot touch a real checkout by accident.
MOD_PATH_1_20_1=/path/to/knaves_needs-1.20.1-multiloader
MOD_PATH_1_21_1=/path/to/knaves_needs-1.21.1-multiloader
