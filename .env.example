# Copy this file to .env (which is git-ignored) and set the absolute paths to your
# local Knaves' Needs multiloader mod roots. One key per supported MC version, named
# MOD_PATH_<version with dots replaced by underscores>.
#
# When you run `python main.py --mc <version>` with no path argument, the matching
# path below is used as the output project root. An explicit path argument still wins.
MOD_PATH_1_20_1=/path/to/knaves_needs-1.20.1-multiloader
MOD_PATH_1_21_1=/path/to/knaves_needs-1.21.1-multiloader
